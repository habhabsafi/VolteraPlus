<%- include('partials/head') %>
<section class="hero"><div class="container"><div class="inner">
  <h1>Certified. <em>Red Seal.</em> Licensed. Trusted.</h1>
  <p>Electrical, general contracting and handy man services for homes and businesses across Ottawa, ON. Quality work, trusted service, building a better tomorrow.</p>
  <div class="btns"><a class="btn btn-gold" href="/contact">Get a Free Estimate</a><a class="btn btn-outline" href="/about">Learn More</a></div>
  <div class="hero-badges"><img src="/images/red-seal.png" alt="Canada Interprovincial Red Seal certified"><div><strong>24/7 Emergency Service</strong>Serving Ottawa, ON and surrounding areas</div></div>
</div></div></section>

<section class="section"><div class="container grid grid-3">
  <div class="feature"><div class="ico">&#9733;</div><h3>Safe. Reliable. Professional.</h3><p>Red Seal certified work done to code, with safety on every job.</p></div>
  <div class="feature"><div class="ico">&#9874;</div><h3>High Quality Results</h3><p>Skilled workmanship using quality materials, built to last.</p></div>
  <div class="feature"><div class="ico">$</div><h3>Competitive Rates</h3><p>Free estimates and fair, transparent pricing with no surprises.</p></div>
</div></section>

<section class="section" style="padding-top:20px"><div class="container split">
  <img src="/images/electrician.jpg" alt="Voltera Plus electrician at work" loading="lazy">
  <div><span class="eyebrow">About Voltera Plus</span><h2>Your Ultimate One-Stop Electrical Solution</h2>
    <p>From a single outlet to full commercial installations, Voltera Plus handles it with care. Our licensed team ensures every detail is addressed, giving you peace of mind.</p>
    <ul class="checks"><li>Licensed electrician</li><li>Red Seal certified</li><li>Free estimates</li><li>Available 24/7</li></ul>
    <a class="btn btn-gold" style="margin-top:26px" href="/about">About Us</a></div>
</div></section>

<section class="section" style="padding-top:0"><div class="container track">
  <h2>Our Track Record Speaks for Itself</h2>
  <div class="stats">
    <div class="stat"><strong>24/7</strong>Emergency availability</div>
    <div class="stat hl"><strong>Red Seal</strong>Certified electrician</div>
    <div class="stat"><strong>Free</strong>Estimates on every job</div>
  </div>
</div></section>

<section class="dark-band section"><div class="container split">
  <div><h2>Customer Satisfaction is Our Priority</h2><p style="margin:14px 0">Your comprehensive and reliable electrical and contracting provider for all your needs.</p>
    <ul class="checks" style="grid-template-columns:1fr"><li>Quality work. Trusted service.</li><li>Open communication and responsive support</li></ul>
    <a class="btn btn-gold" style="margin-top:26px" href="/services">Explore Our Services</a></div>
  <img src="/images/site.jpg" alt="Commercial and industrial electrical work" loading="lazy">
</div></section>

<section class="section"><div class="container">
  <div class="section-head"><h2 class="section-title">Our Electrical Services</h2><a class="btn btn-gold" href="/services#electric">And More &rarr;</a></div>
  <div class="grid grid-3"><% featured.electric.forEach(function(s){ %><%- include('partials/service-card', {s: s}) %><% }) %></div>
</div></section>

<section class="section" style="padding-top:0"><div class="container">
  <div class="section-head"><h2 class="section-title">General Contractor Services</h2><a class="btn btn-gold" href="/services#general-contractor">And More &rarr;</a></div>
  <div class="grid grid-3"><% featured.general.forEach(function(s){ %><%- include('partials/service-card', {s: s}) %><% }) %></div>
</div></section>

<section class="section" style="padding-top:0"><div class="container">
  <div class="section-head"><h2 class="section-title">Handy Man Services</h2><a class="btn btn-gold" href="/services#handyman">And More &rarr;</a></div>
  <div class="grid grid-3"><% featured.handy.forEach(function(s){ %><%- include('partials/service-card', {s: s}) %><% }) %></div>
</div></section>

<section class="section" style="padding-top:0"><div class="container">
  <h2 class="center section-title">How Voltera Plus Works</h2>
  <div class="steps">
    <div class="step"><div class="num">1</div><h3>Pick Your Service</h3><p>Tell us what you need, from a small repair to a large installation.</p></div>
    <div class="step"><div class="num">2</div><h3>Get a Free Estimate</h3><p>We visit, assess the job, and give you a clear quote.</p></div>
    <div class="step"><div class="num">3</div><h3>Confirm and Relax</h3><p>We complete the work safely, on time, and to code.</p></div>
  </div>
</div></section>

<section class="reviews-wrap section"><div class="container">
  <h2 class="center section-title">Customer Satisfaction is Our Priority</h2>
  <div class="grid grid-3"><% reviews.forEach(function(r){ %><%- include('partials/review-card', {r: r}) %><% }) %></div>
</div></section>

<% if (featuredProducts.length) { %>
<section class="section"><div class="container">
  <div class="section-head"><h2 class="section-title">Featured Products</h2><a class="btn btn-gold" href="/products">Browse Products &rarr;</a></div>
  <div class="product-grid"><% featuredProducts.forEach(function(product){ %><%- include('partials/product-card', {product: product}) %><% }) %></div>
</div></section>
<% } %>

<section class="section"><div class="container">
  <h2 class="center section-title">Latest from Our Blog</h2>
  <div class="grid grid-3"><% posts.forEach(function(p){ %><%- include('partials/post-card', {p: p}) %><% }) %></div>
</div></section>
<%- include('partials/foot') %>
