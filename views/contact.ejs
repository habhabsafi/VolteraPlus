<%- include('partials/head') %>
<section class="page-hero" style="padding-bottom:140px"><div class="container"><h1>Contact Us</h1><p>Have a question or need a free estimate? Reach out using the form below or call us 24/7.</p></div></section>

<section style="margin-top:-90px"><div class="container">
  <% if (typeof sent !== 'undefined' && sent) { %><p class="form-ok" style="display:block">Thank you! We received your request and will contact you shortly.</p><% } %>
  <% if (typeof error !== 'undefined' && error) { %><p class="form-ok error" style="display:block">We couldn't process the upload. Please try again or call us.</p><% } %>
  <form class="form-card" data-form method="post" action="/quote" enctype="multipart/form-data">
  <%- include('partials/form-extras', {source: 'contact'}) %>
    <div class="field"><label>Full Name</label><input name="Name" data-req placeholder="Your full name"><span class="err">Please enter your name.</span></div>
    <div class="row">
      <div class="field"><label>Email Address</label><input name="Email" type="email" data-req placeholder="Type your mail address"><span class="err">Please enter a valid email.</span></div>
      <div class="field"><label>Phone Number</label><input name="Phone" type="tel" placeholder="Your phone number"></div>
    </div>
    <div class="field"><label>Required Service</label><%- include('partials/service-select', {selected: ''}) %><span class="err">Please choose a service.</span></div>
    <div class="field"><label>Message</label><textarea name="Message" rows="4" placeholder="Tell us about your project"></textarea></div>
    <%- include('partials/quote-photo-upload') %>
    <button class="btn btn-gold" type="submit">Get in Touch</button><div class="form-ok"></div>
  </form>
</div></section>

<section class="section"><div class="container contact-info">
  <div class="feature"><div class="ico">&#9742;</div><h3>Call Us</h3><p><a href="tel:+13433363433">343 336 3433</a><br>Available 24/7</p></div>
  <div class="feature"><div class="ico">&#9993;</div><h3>Email</h3><p><a href="mailto:abe@volteraplus.ca">abe@volteraplus.ca</a><br>www.volteraplus.ca</p></div>
  <div class="feature"><div class="ico">&#9906;</div><h3>Service Area</h3><p>Serving Ottawa, ON and surrounding areas</p></div>
</div></section>
<%- include('partials/foot') %>
