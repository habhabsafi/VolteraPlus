<%- include('head') %>
<div class="bar"><h1>Team</h1><a class="btn" href="/admin/people/new">+ Add team member</a></div>
<table class="card admin-list">
  <tr><th>Name</th><th>Role</th><th>Order</th><th>Status</th><th></th></tr>
  <% people.forEach(function(person){ %>
  <tr>
    <td data-label="Name"><a href="/admin/people/<%= person.id %>"><%= person.name %></a></td>
    <td data-label="Role"><%= person.role %></td><td data-label="Order"><%= person.sort_order %></td><td data-label="Status"><%= person.published ? 'Published' : 'Hidden' %></td>
    <td class="actions" data-label="Actions"><a class="btn ghost" href="/admin/people/<%= person.id %>">Edit</a>
      <form method="post" action="/admin/people/<%= person.id %>/delete" data-confirm="Delete this team member? This cannot be undone."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger">Delete</button></form></td>
  </tr>
  <% }) %>
</table>
<%- include('foot') %>
