<%- include('head') %>
<div class="bar"><h1>Reviews</h1><a class="btn" href="/admin/reviews/new">+ Add review</a></div>
<table class="card admin-list">
  <tr><th>Title</th><th>Customer</th><th>Order</th><th>Status</th><th></th></tr>
  <% reviews.forEach(function(r){ %>
  <tr>
    <td data-label="Title"><a href="/admin/reviews/<%= r.id %>"><%= r.title %></a></td><td data-label="Customer"><%= r.name %>, <%= r.role %></td><td data-label="Order"><%= r.sort_order %></td><td data-label="Status"><%= r.published ? 'Published' : 'Hidden' %></td>
    <td class="actions" data-label="Actions"><a class="btn ghost" href="/admin/reviews/<%= r.id %>">Edit</a>
      <form method="post" action="/admin/reviews/<%= r.id %>/delete" data-confirm="Delete this review? This cannot be undone."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger">Delete</button></form></td>
  </tr>
  <% }) %>
</table>
<%- include('foot') %>
