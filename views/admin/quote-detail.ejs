<%- include('head') %>
<div class="bar"><h1>Request from <%= quote.name %></h1><a class="btn ghost" href="/admin/quotes">&larr; All requests</a></div>
<div class="card">
  <p><b>Received:</b> <%= String(quote.created_at).slice(0, 16).replace('T', ' ') %> &middot; <b>From:</b> <%= quote.source || '-' %> &middot; <b>Owner emailed:</b> <%= quote.email_sent ? 'yes' : 'no' %></p>
  <p><b>Email:</b> <a href="mailto:<%= quote.email %>"><%= quote.email %></a><% if (quote.phone) { %> &middot; <b>Phone:</b> <a href="tel:<%= quote.phone.replace(/[^\d+]/g, '') %>"><%= quote.phone %></a><% } %></p>
  <p><b>Service:</b> <%= quote.service || '-' %></p>
  <p><b>Message</b></p><p style="white-space:pre-wrap"><%= quote.message || '-' %></p>
</div>
<form class="card" method="post" action="/admin/quotes/<%= quote.id %>">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Status<select name="status"><% ['new','contacted','quoted','won','lost'].forEach(function(s){ %><option value="<%= s %>"<%= quote.status === s ? ' selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option><% }) %></select></label>
  <label>Internal notes<textarea name="notes" rows="4" maxlength="4000"><%= quote.notes %></textarea></label>
  <button class="btn" type="submit">Save</button>
</form>
<form method="post" action="/admin/quotes/<%= quote.id %>/delete" data-confirm="Delete this request? This cannot be undone."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger">Delete request</button></form>
<%- include('foot') %>
