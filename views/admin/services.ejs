<%- include('head') %>
<div class="bar"><h1>Services</h1><a class="btn" href="/admin/services/new">+ Add service</a></div>
<table class="card">
  <tr><th>Name</th><th>Category</th><th>Order</th><th>Home page</th><th>Status</th><th></th></tr>
  <% services.forEach(function(s){ %>
  <tr>
    <td><a href="/admin/services/<%= s.id %>"><%= s.name %></a></td><td><%= s.cat_name %></td><td><%= s.sort_order %></td>
    <td><%= s.featured_order ? 'Featured #' + s.featured_order : '-' %></td><td><%= s.published ? 'Published' : 'Hidden' %></td>
    <td class="actions"><a class="btn ghost" href="/admin/services/<%= s.id %>">Edit</a>
      <form method="post" action="/admin/services/<%= s.id %>/delete" data-confirm="Delete this service? This cannot be undone."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger">Delete</button></form></td>
  </tr>
  <% }) %>
</table>
<%- include('foot') %>
