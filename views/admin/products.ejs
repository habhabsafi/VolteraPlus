<%- include('head') %>
<div class="bar"><h1>Products</h1><a class="btn" href="/admin/products/new">Add product</a></div>
<section class="card"><h2>Product categories</h2>
  <form class="category-add-form" method="post" action="/admin/product-categories">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>New category<input name="name" maxlength="150" required placeholder="e.g. Test Equipment"></label>
    <label>Sort order<input type="number" name="sort_order" min="0" max="9999" value="0"></label>
    <button class="btn" type="submit">Add category</button>
  </form>
  <% if (categories.length) { %><div class="category-admin-list">
    <% categories.forEach(function(category){ %><div class="category-admin-row">
      <form method="post" action="/admin/product-categories/<%= category.id %>">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label>Category<input name="name" value="<%= category.name %>" maxlength="150" required></label>
        <label>Sort order<input type="number" name="sort_order" min="0" max="9999" value="<%= category.sort_order %>"></label>
        <span><%= category.product_count %> <%= category.product_count === 1 ? 'product' : 'products' %></span>
        <button class="btn ghost" type="submit">Save</button>
      </form>
      <% if (!category.product_count) { %><form method="post" action="/admin/product-categories/<%= category.id %>/delete" data-confirm="Delete this category?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger" type="submit">Delete</button></form><% } %>
    </div><% }) %>
  </div><% } else { %><p class="muted">Add a category before creating products.</p><% } %>
</section>
<section class="card"><h2>Product catalogue</h2>
  <div class="table-scroll"><table class="admin-list"><thead><tr><th>Image</th><th>Title</th><th>Category</th><th>Visibility</th><th>Order</th></tr></thead><tbody>
    <% products.forEach(function(product){ %><tr>
      <td><img class="admin-product-thumb" src="<%= imgUrl(product.image) %>" alt=""></td>
      <td><a href="/admin/products/<%= product.id %>"><%= product.title %></a></td>
      <td><%= product.category_name %></td>
      <td><span class="pill <%= product.published ? 'won' : 'lost' %>"><%= product.published ? 'Published' : 'Draft' %></span></td>
      <td><%= product.sort_order %></td>
    </tr><% }) %>
    <% if (!products.length) { %><tr><td colspan="5" class="muted">No products yet.</td></tr><% } %>
  </tbody></table></div>
</section>
<%- include('foot') %>
