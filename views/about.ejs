<%- include('partials/head') %>
<section class="page-hero"><div class="container"><h1>About Voltera Plus</h1><p>Licensed Electrical, general contracting and handy man professionals dedicated to quality service in Ottawa, ON.</p></div></section>

<section class="section" ><div class="container">
  <h2 class="center section-title">Meet Our Team</h2>
  <div class="team-profiles">
    <% people.forEach(function(person){ %>
    <div class="split team-profile">
      <img class="profile-photo" src="<%= imgUrl(person.img) %>" alt="<%= person.name %>, <%= person.role %>" loading="lazy">
      <div><span class="eyebrow">Meet <%= person.name %></span><h2><%= person.headline %></h2>
        <p class="muted"><%= person.role %></p><p><%= person.bio %></p>
        <% if (person.highlights.length) { %><ul class="checks"><% person.highlights.forEach(function(highlight){ %><li><%= highlight %></li><% }) %></ul><% } %>
        <% if (person.badge_img) { %><img class="seal" src="<%= imgUrl(person.badge_img) %>" alt="<%= person.role %> credential" loading="lazy" style="margin-top:26px"><% } %>
      </div>
    </div>
    <% }) %>
  </div>
</div></section>

<section class="section" style="padding-top:0"><div class="container grid grid-3">
  <div class="feature"><div class="ico">&#9889;</div><h3>Reliability &amp; Trust</h3><p>Looking for a dependable electrician? We arrive on time and do the job right.</p></div>
  <div class="feature"><div class="ico">&#9874;</div><h3>Quality Workmanship</h3><p>Skilled work using quality materials on every project.</p></div>
  <div class="feature"><div class="ico">$</div><h3>Fair &amp; Transparent Pricing</h3><p>No surprises. Free estimates and clear quotes.</p></div>
</div></section>

<section class="section" style="padding-top:0"><div class="container split" style="grid-template-columns:1fr 1.2fr">
  <div><h2>The Complete Electrical Service Hub</h2><p style="margin:12px 0 22px">From a flickering light to a full panel upgrade, we have you covered.</p>
    <div class="acc">
      <div class="open"><button type="button">Safe. Reliable. Professional.<span>&minus;</span></button><div class="panel"><p>Every job is done to the Canadian Electrical Code with safety first.</p></div></div>
      <div><button type="button">24/7 Emergency Service<span>+</span></button><div class="panel"><p>Power out or an electrical hazard? Call us any time, day or night.</p></div></div>
      <div><button type="button">Competitive Rates<span>+</span></button><div class="panel"><p>Free estimates and fair prices for homes and businesses.</p></div></div>
    </div></div>
  <div class="side-img"><img src="/images/solder.jpg" alt="Electrical work" loading="lazy"></div>
</div></section>

<section class="section" style="padding-top:0"><div class="container">
  <h2 class="center section-title">Our Commitment</h2>
  <div class="commit">
    <p>At Voltera Plus, we believe good electrical work is built on trust. Every project, from a single outlet to a full commercial installation, is completed by a licensed, Red Seal certified electrician to the highest safety standards.</p>
    <p>We show up on time, explain the work clearly, give honest free estimates, and leave your space clean and safe. With 24/7 emergency availability across Ottawa, ON and surrounding areas, you can count on us when it matters most. Quality work. Trusted service. Building a better tomorrow.</p>
  </div>
</div></section>
<%- include('partials/foot') %>
