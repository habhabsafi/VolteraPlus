<select name="Service" data-req><option value="">Select your required service</option><% categories.forEach(function(c){ %><optgroup label="<%= c.name %>"><% allServices.filter(function(s){return s.cat === c.id}).forEach(function(s){ %><option<%= s.name === selected ? ' selected' : '' %>><%= s.name %></option><% }) %></optgroup><% }) %><option<%= selected === 'Emergency Service' ? ' selected' : '' %>>Emergency Service</option></select>
